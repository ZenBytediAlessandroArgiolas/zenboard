# ===================================================================
# EduBoard - Configurazione Variabili d'Ambiente
# ===================================================================

# Percorso Host per il volume Google Drive:
# Se hai l'app "Google Drive per Desktop" installata, specifica il percorso esatto della cartella.
# Esempio Windows: GOOGLE_DRIVE_PATH="G:/Il mio Drive/EduBoard"
# Esempio Mac: GOOGLE_DRIVE_PATH="/Users/docente/Google Drive/EduBoard"
# Esempio Linux: GOOGLE_DRIVE_PATH="/home/docente/google-drive/EduBoard"
# Default locale: ./data (crea la cartella 'data' all'interno della directory del progetto)
GOOGLE_DRIVE_PATH=./data

# URL del server backend visibile dal browser dei client
# In locale: http://localhost:3001
# In rete LAN per gli studenti: http://192.168.1.X:3001
# Con tunnel pubblico (es. Cloudflare Tunnel / ngrok): https://tuo-tunnel-backend.trycloudflare.com
VITE_BACKEND_URL=http://localhost:3001

# Porta del backend
PORT=3001

# ===================================================================
# ACCESSO PREMIUM (Docente) - Login JWT
# ===================================================================
# ZenBoard distingue due livelli di accesso:
#   - Free / Ospite: nessun login, lavagna in tempo reale + download PDF
#   - Premium / Docente: login richiesto, sblocca salvataggio su Drive,
#     gestione multi-pagina e rinomina lezione
#
# ⚠️ IMPORTANTE: cambia questi valori prima di esporre ZenBoard fuori
# dalla tua rete locale (es. con ngrok / Cloudflare Tunnel). I valori
# di default sono pensati solo per lo sviluppo in locale.

# Username del Docente
ADMIN_USERNAME=docente

# Password del Docente (in chiaro, va bene per uso locale/didattico)
ADMIN_PASSWORD=zenboard2024

# Secret usato per firmare i token JWT: usa una stringa lunga e casuale
JWT_SECRET=cambia-questa-stringa-con-un-valore-segreto-lungo-e-casuale

# Durata del token di sessione (es. 1h, 12h, 24h, 7d)
JWT_EXPIRY=24h
